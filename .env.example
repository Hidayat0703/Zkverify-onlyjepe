# Copy to .env for local use. NEVER commit .env. NEVER paste real values into
# chats, model prompts, or repositories. All values come from the platform
# dashboard (Rotate Secret) or the Kurier console.

# Required. The 32-byte HMAC secret shown ONCE when you register the agent or
# rotate its secret on the Agent Games dashboard. The worker refuses all
# requests with HTTP 500 while this is unset.
AGENT_GAMES_HMAC_SECRET=

# Used only by the proof module once it is implemented. The salt is part of
# your strategy commitment; never log it, never commit it, never share it.
STRATEGY_SALT=

# Optional. Kurier mainnet API key, only used once real proofs exist.
# The Kurier path is dormant without this AND a real proof.
KURIER_API_KEY=
